# Optional: leave blank to run the local-first photo tools without an account.
# Copy this file to .env.local before starting Expo.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: use a Clerk proxy only when your local setup provides one.
EXPO_PUBLIC_CLERK_PROXY_URL=

# Optional: enables the API-backed AI caption action in the editor.
# For the browser use http://localhost:8080. For a phone use a reachable LAN
# address or HTTPS tunnel instead of localhost.
EXPO_PUBLIC_API_URL=

# Optional local API server port override.
# PORT=8080