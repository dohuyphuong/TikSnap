{
  "name": "@workspace/quick-mark",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/start.js --localhost --port ${PORT:-8081}",
    "dev:localhost": "node scripts/start.js --localhost --port ${PORT:-8081}",
    "dev:lan": "node scripts/start.js --lan --port ${PORT:-8081}",
    "dev:tunnel": "node scripts/start.js --tunnel --port ${PORT:-8081}",
    "dev:device": "sh -c 'node scripts/start.js --tunnel --port ${PORT:-8081} || exec node scripts/start.js --lan --port ${PORT:-8081}'",
    "build": "node scripts/build.js",
    "build:local": "EXPO_PUBLIC_DOMAIN=localhost:3000 EXPO_PUBLIC_PROTOCOL=http node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
