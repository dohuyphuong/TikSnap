{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F7F9FC" },
      "foreground": { "$value": "#132238" },
      "border": { "$value": "#DDE5F0" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#132238" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#132238" },
      "primary": {
        "$value": "#1457FF",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#EAF0FF" },
      "secondaryForeground": { "$value": "#173776" },
      "muted": { "$value": "#EEF2F7" },
      "mutedForeground": { "$value": "#6C7B91" },
      "accent": { "$value": "#FFF0E8" },
      "accentForeground": { "$value": "#A8471F" },
      "destructive": { "$value": "#E5484D" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#DDE5F0" },
      "ring": { "$value": "#1457FF" },
      "chart1": { "$value": "#FF5C5C" },
      "chart2": { "$value": "#FFD166" },
      "chart3": { "$value": "#49D6B2" },
      "chart4": { "$value": "#25334A" },
      "chart5": { "$value": "#8EA6FF" },
      "sidebar": { "$value": "#F7F9FC" },
      "sidebarForeground": { "$value": "#132238" },
      "sidebarBorder": { "$value": "#DDE5F0" },
      "sidebarPrimary": { "$value": "#1457FF" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#EAF0FF" },
      "sidebarAccentForeground": { "$value": "#173776" },
      "sidebarRing": { "$value": "#1457FF" },
      "editorBackground": { "$value": "#111C2F" },
      "editorSurface": { "$value": "#25334A" }
    },
    "dark": {
      "background": { "$value": "#111C2F" },
      "foreground": { "$value": "#FFFFFF" },
      "border": { "$value": "#3A4860" },
      "card": { "$value": "#25334A" },
      "cardForeground": { "$value": "#FFFFFF" },
      "popover": { "$value": "#25334A" },
      "popoverForeground": { "$value": "#FFFFFF" },
      "primary": { "$value": "#6B8DFF" },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#33456A" },
      "secondaryForeground": { "$value": "#EAF0FF" },
      "muted": { "$value": "#1C2B43" },
      "mutedForeground": { "$value": "#9EABC1" },
      "accent": { "$value": "#4A352D" },
      "accentForeground": { "$value": "#FFD4BE" },
      "destructive": { "$value": "#FF6B70" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#3A4860" },
      "ring": { "$value": "#6B8DFF" },
      "chart1": { "$value": "#FF5C5C" },
      "chart2": { "$value": "#FFD166" },
      "chart3": { "$value": "#49D6B2" },
      "chart4": { "$value": "#8EA6FF" },
      "chart5": { "$value": "#FF9E80" },
      "sidebar": { "$value": "#111C2F" },
      "sidebarForeground": { "$value": "#FFFFFF" },
      "sidebarBorder": { "$value": "#3A4860" },
      "sidebarPrimary": { "$value": "#6B8DFF" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#25334A" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing": { "$value": "#6B8DFF" },
      "editorBackground": { "$value": "#111C2F" },
      "editorSurface": { "$value": "#25334A" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
